{
  "schema": 1,
  "purpose": "修订73独立静态审计；仅解析已生成汇编和ELF对象字节，不执行原生、构建或性能",
  "plan_sha256": "9935e28c5c00f1f2479ac02f58f8dd30338c1af6612ec7240a4fd52252ba61f2",
  "original_inspect_sha256": "93d60c8f0723bf08e775f19d396fbd83f0f3a764ddcc323fe017483583fe3ce2",
