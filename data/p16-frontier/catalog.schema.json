{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "flash-chroma三维权衡记录",
  "description": "结构校验不替代引用证据的实际数值验收。",
  "type": "object",
  "required": ["schema", "contexts", "models", "candidates"],
  "properties": {
    "schema": {"const": "flash_chroma_frontier_v1"},
    "contexts": {"type": "object", "additionalProperties": {"$ref": "#/$defs/context"}},
    "models": {"type": "object", "additionalProperties": {"type": "object"}},
    "candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "context": {
      "type": "object",
      "required": ["source_luts_sha256", "dataset_sha256", "platform_id", "timing_scope", "image_mode", "build_id"],
      "properties": {
        "source_luts_sha256": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/sha"}},
        "dataset_sha256": {"$ref": "#/$defs/sha"},
        "platform_id": {"type": "string", "minLength": 1},
        "timing_scope": {"type": "string", "minLength": 1},
        "image_mode": {"type": "string", "minLength": 1},
        "build_id": {"type": "string", "minLength": 1}
      }
    },
    "config": {
      "type": "object",
      "required": ["target", "backend", "representation", "threads", "block_pixels", "max_workspace_bytes"],
      "properties": {
        "target": {"enum": ["desktop", "mobile", "embedded", "portable"]},
        "backend": {"enum": ["scalar", "avx2"]},
        "representation": {"enum": ["sparse", "direct_u8", "direct_u16", "direct_rgb24"]},
        "threads": {"type": "integer", "minimum": 1, "maximum": 256},
        "block_pixels": {"type": "integer", "minimum": 1},
        "max_workspace_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "metrics": {
      "type": "object",
      "required": ["mean_error", "worst_image_mean", "batch_ms", "runtime_bytes", "workspace_bytes"],
      "properties": {
        "mean_error": {"type": ["number", "null"], "minimum": 0},
        "worst_image_mean": {"type": ["number", "null"], "minimum": 0},
        "batch_ms": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "runtime_bytes": {"type": ["integer", "null"], "minimum": 0},
        "workspace_bytes": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "verified": {
      "type": "object",
      "required": ["correctness", "accuracy", "resources", "time", "time_stable"],
      "properties": {
        "correctness": {"type": "boolean"}, "accuracy": {"type": "boolean"},
        "resources": {"type": "boolean"}, "time": {"type": "boolean"}, "time_stable": {"type": "boolean"}
      }
    },
    "candidate": {
      "type": "object",
      "required": ["id", "context", "model_id", "evidence", "config", "metrics", "verified"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "context": {"type": "string", "minLength": 1},
        "model_id": {"type": "string", "minLength": 1}, "evidence": {"type": "string", "minLength": 1},
        "config": {"$ref": "#/$defs/config"}, "metrics": {"$ref": "#/$defs/metrics"},
        "verified": {"$ref": "#/$defs/verified"}
      }
    }
  }
}
